{
    "name": "van-ons/filament-form-builder",
    "description": "Add a customizable form builder to your Filament admin panel.",
    "keywords": [
        "laravel",
        "filament",
        "form-builder"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Van Ons",
            "email": "opensource@van-ons.nl"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.13|^5.8",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.93.1",
        "symfony/html-sanitizer": "^7.0|^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.87",
        "orchestra/testbench": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "van-ons/filament-multisite": "Link a form to its translations per site, like pages (set `multisite` to true)."
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/php-cs-fixer fix",
        "format:check": "vendor/bin/php-cs-fixer check",
        "test": "vendor/bin/pest",
        "multisite": [
            "@php -r \"copy('composer.json', 'composer-multisite.json'); file_exists('composer.lock') && copy('composer.lock', 'composer-multisite.lock');\"",
            "@putenv COMPOSER=composer-multisite.json",
            "@composer config repositories.filament-multisite vcs https://github.com/VanOns/filament-multisite",
            "@composer require --dev van-ons/filament-multisite:^2.1 --no-interaction"
        ]
    },
    "scripts-descriptions": {
        "multisite": "Installs the private van-ons/filament-multisite for the tests of forms per site, leaving composer.json alone."
    },
    "autoload": {
        "psr-4": {
            "VanOns\\FilamentFormBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VanOns\\FilamentFormBuilder\\FilamentFormBuilderProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
